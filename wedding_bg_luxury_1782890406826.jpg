import { Heart } from "lucide-react";
import { motion } from "motion/react";

export default function MessageSection() {
  return (
    <section
      id="message"
      className="relative bg-gradient-to-b from-[#F9F7F2] via-[#f0eada]/40 to-[#F9F7F2] py-32 px-6 overflow-hidden text-center"
    >
      {/* Background patterns */}
      <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-radial-[circle_at_center,rgba(180,151,90,0.06)_0%,transparent_70%] pointer-events-none" />

      <div className="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
        {/* Soft Decorative Line */}
        <motion.div
          initial={{ opacity: 0, scaleX: 0 }}
          whileInView={{ opacity: 1, scaleX: 1 }}
          viewport={{ once: true, margin: "-100px" }}
          transition={{ duration: 1.5 }}
          className="w-32 h-[1px] bg-gradient-to-r from-transparent via-gold-400 to-transparent mb-12"
        />

        {/* Script Names Logo */}
        <motion.p
          initial={{ opacity: 0, y: 35 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, margin: "-100px" }}
          transition={{ duration: 1.2, ease: "easeOut" }}
          className="font-script text-6xl sm:text-7xl md:text-8xl text-gold-500 mb-8 select-none tracking-wide text-glow"
        >
          Anis & Khitem
        </motion.p>

        {/* Elegant Joining Heart */}
        <motion.div
          initial={{ opacity: 0, scale: 0.8 }}
          whileInView={{ opacity: [0, 1] }}
          viewport={{ once: true }}
          transition={{ duration: 1 }}
          className="mb-8"
        >
          <Heart className="w-6 h-6 text-gold-400/50 fill-gold-400/5" />
        </motion.div>

        {/* Warm invitation quotation */}
        <motion.blockquote
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, margin: "-100px" }}
          transition={{ delay: 0.3, duration: 1.2, ease: "easeOut" }}
          className="font-serif italic text-[#4A4238]/90 text-lg sm:text-2xl leading-relaxed tracking-wide font-light max-w-xl"
        >
          "Votre présence sera le plus beau cadeau que nous puissions recevoir. Nous avons hâte de partager avec vous ce moment unique de notre vie."
        </motion.blockquote>

        {/* Closing Separator */}
        <motion.div
          initial={{ opacity: 0, scaleX: 0 }}
          whileInView={{ opacity: 1, scaleX: 1 }}
          viewport={{ once: true, margin: "-100px" }}
          transition={{ delay: 0.5, duration: 1.5 }}
          className="w-32 h-[1px] bg-gradient-to-r from-transparent via-gold-400 to-transparent mt-12"
        />
      </div>
    </section>
  );
}
