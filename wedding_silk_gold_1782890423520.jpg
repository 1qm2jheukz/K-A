import { useState } from "react";
import { Calendar, Clock, MapPin, Map, Edit2, Check, X } from "lucide-react";
import { motion, AnimatePresence } from "motion/react";
import { WeddingInfo } from "../types";

interface DetailsSectionProps {
  info: WeddingInfo;
  isAdmin?: boolean;
  onUpdateInfo?: (updated: WeddingInfo) => void;
}

export default function DetailsSection({ info, isAdmin, onUpdateInfo }: DetailsSectionProps) {
  const [isEditing, setIsEditing] = useState(false);
  const [editDate, setEditDate] = useState(info.date);
  const [editTime, setEditTime] = useState(info.time);
  const [editLocation, setEditLocation] = useState(info.locationName);
  const [editAddress, setEditAddress] = useState(info.address);
  const [editMapsUrl, setEditMapsUrl] = useState(info.googleMapsUrl);

  const startEditing = () => {
    setEditDate(info.date);
    setEditTime(info.time);
    setEditLocation(info.locationName);
    setEditAddress(info.address);
    setEditMapsUrl(info.googleMapsUrl);
    setIsEditing(true);
  };

  const handleSave = () => {
    const dateObj = new Date(editDate);
    let formatted = info.formattedDate;

    if (!isNaN(dateObj.getTime())) {
      const months = [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
      ];
      const day = dateObj.getDate();
      const month = months[dateObj.getMonth()];
      const year = dateObj.getFullYear();
      formatted = `${day} ${month} ${year}`;
    }

    if (onUpdateInfo) {
      onUpdateInfo({
        date: editDate,
        formattedDate: formatted,
        time: editTime,
        locationName: editLocation,
        address: editAddress,
        googleMapsUrl: editMapsUrl,
      });
    }

    setIsEditing(false);
  };

  const handleCancel = () => {
    setIsEditing(false);
  };
  return (
    <section
      id="details"
      className="relative min-h-screen w-full bg-[#F9F7F2] flex items-center justify-center py-24 px-6 overflow-hidden"
    >
      {/* Background radial glow */}
      <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-gold-400/10 blur-[120px] pointer-events-none" />

      {/* Decorative floral or spiral background vectors (pure CSS) */}
      <div className="absolute top-10 left-10 w-48 h-48 border border-gold-400/15 rounded-full flex items-center justify-center opacity-40 pointer-events-none">
        <div className="w-40 h-40 border border-gold-400/10 rounded-full" />
      </div>
      <div className="absolute bottom-10 right-10 w-72 h-72 border border-gold-400/15 rounded-full flex items-center justify-center opacity-30 pointer-events-none">
        <div className="w-64 h-64 border border-gold-400/10 rounded-full" />
      </div>

      <div className="relative z-10 w-full max-w-2xl">
        <motion.div
          initial={{ opacity: 0, y: 40 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, margin: "-100px" }}
          transition={{ duration: 1.2, ease: "easeOut" }}
          className="glass rounded-3xl p-8 sm:p-12 text-center border border-gold-400/30 shadow-gold-lg relative"
        >
          {/* Accent Gold Corner Lines */}
          <div className="absolute top-4 left-4 w-6 h-6 border-t border-l border-gold-400/40" />
          <div className="absolute top-4 right-4 w-6 h-6 border-t border-r border-gold-400/40" />
          <div className="absolute bottom-4 left-4 w-6 h-6 border-b border-l border-gold-400/40" />
          <div className="absolute bottom-4 right-4 w-6 h-6 border-b border-r border-gold-400/40" />

          {/* Section Header */}
          <span className="font-script text-3xl sm:text-4xl text-gold-500 tracking-wider mb-2 block animate-pulse-slow">
            Notre Mariage
          </span>
          <h2 className="font-serif text-3xl sm:text-4xl tracking-[0.2em] text-[#2D2926] uppercase mb-8">
            Informations
          </h2>

          <div className="h-[1px] w-24 bg-gradient-to-r from-transparent via-gold-400 to-transparent mx-auto mb-10" />

          {/* Details Content */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10 text-left">
            {/* Date Detail */}
            <div className="flex flex-col items-center text-center p-4 rounded-xl hover:bg-gold-400/5 transition-colors duration-300 group">
              <div className="w-12 h-12 rounded-full border border-gold-400/30 flex items-center justify-center text-gold-500 mb-4 group-hover:scale-110 transition-transform">
                <Calendar className="w-5 h-5" />
              </div>
              <span className="font-sans text-[10px] uppercase tracking-[0.2em] text-[#4A4238]/60 mb-1">
                Date
              </span>
              <p className="font-serif text-lg text-[#2D2926] font-medium">
                {info.formattedDate}
              </p>
            </div>

            {/* Time Detail */}
            <div className="flex flex-col items-center text-center p-4 rounded-xl hover:bg-gold-400/5 transition-colors duration-300 group">
              <div className="w-12 h-12 rounded-full border border-gold-400/30 flex items-center justify-center text-gold-500 mb-4 group-hover:scale-110 transition-transform">
                <Clock className="w-5 h-5" />
              </div>
              <span className="font-sans text-[10px] uppercase tracking-[0.2em] text-[#4A4238]/60 mb-1">
                Heure
              </span>
              <p className="font-serif text-lg text-[#2D2926] font-medium">
                {info.time}
              </p>
            </div>

            {/* Location Detail */}
            <div className="flex flex-col items-center text-center p-4 rounded-xl hover:bg-gold-400/5 transition-colors duration-300 group">
              <div className="w-12 h-12 rounded-full border border-gold-400/30 flex items-center justify-center text-gold-500 mb-4 group-hover:scale-110 transition-transform">
                <MapPin className="w-5 h-5" />
              </div>
              <span className="font-sans text-[10px] uppercase tracking-[0.2em] text-[#4A4238]/60 mb-1">
                Lieu
              </span>
              <p className="font-serif text-lg text-[#2D2926] font-medium truncate max-w-full">
                {info.locationName}
              </p>
              <p className="font-sans text-xs text-[#4A4238]/80 font-light mt-1 text-center line-clamp-2">
                {info.address}
              </p>
            </div>
          </div>

          {/* Elegant Google Map Embed & View Location Button */}
          <div className="mt-10 pt-10 border-t border-gold-400/20 text-center flex flex-col items-center">
            <div className="flex items-center gap-2 mb-4">
              <MapPin className="w-4 h-4 text-gold-500 animate-pulse" />
              <span className="font-serif text-sm tracking-widest uppercase text-[#2D2926] font-medium">
                Plan d'Accès Interactif
              </span>
            </div>

            {/* Google Map Embedded Frame */}
            <div className="w-full h-64 sm:h-80 rounded-2xl overflow-hidden border border-gold-400/25 shadow-md relative group mb-6 bg-white/40 backdrop-blur-sm">
              <iframe
                src={`https://maps.google.com/maps?q=${encodeURIComponent(info.locationName + " " + info.address)}&t=&z=14&ie=UTF8&iwloc=&output=embed`}
                className="w-full h-full border-0 absolute inset-0"
                allowFullScreen={true}
                loading="lazy"
                referrerPolicy="no-referrer-when-downgrade"
                title="Lieu du Mariage"
              ></iframe>
            </div>

            {/* View Location Link Button with Elegant Hover Animation */}
            <a
              href={info.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              id="view-location-btn"
              className="group relative inline-flex items-center gap-2.5 px-8 py-3.5 bg-white border border-gold-400/30 hover:border-gold-500 rounded-xl font-serif text-xs tracking-widest uppercase text-gold-600 hover:text-gold-700 font-semibold transition-all duration-300 shadow-sm hover:shadow-gold-lg hover:-translate-y-0.5 active:translate-y-0 cursor-pointer overflow-hidden mb-6"
            >
              <Map className="w-4.5 h-4.5 text-gold-500 group-hover:rotate-12 transition-transform duration-300" />
              <span>Voir le Lieu (Google Maps)</span>
            </a>
          </div>

          {/* Admin Control Button - ONLY visible in Admin Mode */}
          {isAdmin && !isEditing && (
            <div className="flex justify-center mt-6 pt-6 border-t border-gold-400/15">
              <button
                id="edit-details-btn"
                onClick={startEditing}
                className="flex items-center gap-2 text-xs font-sans tracking-widest uppercase text-gold-600 hover:text-gold-700 transition-colors cursor-pointer border border-gold-400/40 rounded-full px-5 py-2.5 hover:bg-gold-400/10 font-medium"
              >
                <Edit2 className="w-3.5 h-3.5" /> Modifier les détails (Admin)
              </button>
            </div>
          )}

          {/* Interactive sliding editor panel - ONLY visible in Admin Mode & when isEditing is true */}
          <AnimatePresence>
            {isAdmin && isEditing && (
              <motion.div
                initial={{ opacity: 0, height: 0 }}
                animate={{ opacity: 1, height: "auto" }}
                exit={{ opacity: 0, height: 0 }}
                transition={{ duration: 0.4 }}
                className="mt-8 pt-8 border-t border-gold-400/20 text-left"
              >
                <h3 className="font-serif text-lg tracking-wider text-gold-600 uppercase mb-6 font-medium text-center">
                  Modifier les détails de l'événement
                </h3>
                <div className="grid grid-cols-1 gap-5">
                  {/* Date Input */}
                  <div>
                    <label className="block text-[10px] uppercase tracking-[0.15em] text-[#4A4238]/80 mb-1.5 font-medium">
                      Date du Mariage
                    </label>
                    <input
                      type="date"
                      value={editDate}
                      onChange={(e) => setEditDate(e.target.value)}
                      className="w-full bg-white/75 border border-gold-400/30 rounded-xl px-4 py-3 text-[#2D2926] focus:outline-none focus:border-gold-500 text-sm font-sans focus:ring-1 focus:ring-gold-500 transition-all shadow-inner"
                    />
                  </div>

                  {/* Time Input */}
                  <div>
                    <label className="block text-[10px] uppercase tracking-[0.15em] text-[#4A4238]/80 mb-1.5 font-medium">
                      Heure de l'événement
                    </label>
                    <input
                      type="text"
                      value={editTime}
                      onChange={(e) => setEditTime(e.target.value)}
                      placeholder="Ex: 18:00"
                      className="w-full bg-white/75 border border-gold-400/30 rounded-xl px-4 py-3 text-[#2D2926] focus:outline-none focus:border-gold-500 text-sm font-sans focus:ring-1 focus:ring-gold-500 transition-all shadow-inner"
                    />
                  </div>

                  {/* Venue Input */}
                  <div>
                    <label className="block text-[10px] uppercase tracking-[0.15em] text-[#4A4238]/80 mb-1.5 font-medium">
                      Nom du Lieu / Salle des fêtes
                    </label>
                    <input
                      type="text"
                      value={editLocation}
                      onChange={(e) => setEditLocation(e.target.value)}
                      placeholder="Ex: Salle des Fêtes Royal Élite"
                      className="w-full bg-white/75 border border-gold-400/30 rounded-xl px-4 py-3 text-[#2D2926] focus:outline-none focus:border-gold-500 text-sm font-sans focus:ring-1 focus:ring-gold-500 transition-all shadow-inner"
                    />
                  </div>

                  {/* Address Input */}
                  <div>
                    <label className="block text-[10px] uppercase tracking-[0.15em] text-[#4A4238]/80 mb-1.5 font-medium">
                      Adresse complète du lieu
                    </label>
                    <input
                      type="text"
                      value={editAddress}
                      onChange={(e) => setEditAddress(e.target.value)}
                      placeholder="Ex: Zone Touristique Gammarth, Tunis, Tunisie"
                      className="w-full bg-white/75 border border-gold-400/30 rounded-xl px-4 py-3 text-[#2D2926] focus:outline-none focus:border-gold-500 text-sm font-sans focus:ring-1 focus:ring-gold-500 transition-all shadow-inner"
                    />
                  </div>

                  {/* Google Maps Link Input */}
                  <div>
                    <label className="block text-[10px] uppercase tracking-[0.15em] text-[#4A4238]/80 mb-1.5 font-medium">
                      Lien Google Maps
                    </label>
                    <input
                      type="text"
                      value={editMapsUrl}
                      onChange={(e) => setEditMapsUrl(e.target.value)}
                      placeholder="Ex: https://maps.app.goo.gl/..."
                      className="w-full bg-white/75 border border-gold-400/30 rounded-xl px-4 py-3 text-[#2D2926] focus:outline-none focus:border-gold-500 text-sm font-sans focus:ring-1 focus:ring-gold-500 transition-all shadow-inner"
                    />
                  </div>
                </div>

                {/* Form Action Buttons */}
                <div className="flex justify-end gap-3 mt-8 pt-4 border-t border-gold-400/10">
                  <button
                    onClick={handleCancel}
                    className="flex items-center gap-1.5 px-5 py-2.5 border border-gold-400/30 rounded-full text-xs font-sans tracking-wider uppercase text-[#4A4238]/80 hover:bg-gold-400/5 cursor-pointer transition-colors"
                  >
                    <X className="w-3.5 h-3.5" /> Annuler
                  </button>
                  <button
                    onClick={handleSave}
                    className="flex items-center gap-1.5 px-6 py-2.5 bg-gradient-to-r from-gold-500 to-gold-600 rounded-full text-xs font-sans tracking-wider uppercase text-white font-semibold hover:opacity-95 shadow-md shadow-gold-500/20 hover:shadow-lg transition-all cursor-pointer"
                  >
                    <Check className="w-3.5 h-3.5" /> Enregistrer
                  </button>
                </div>
              </motion.div>
            )}
          </AnimatePresence>
        </motion.div>
      </div>
    </section>
  );
}
